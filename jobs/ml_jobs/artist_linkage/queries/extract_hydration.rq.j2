PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX schema: <http://schema.org/>

{#
  Pass 2 (Hydration) of the two-pass discovery+hydration pattern (see
  extract_discovery.rq.j2 for Pass 1). Fetches labels/description/image/
  wikipedia/birth date/professions/genres/languages/aliases for an explicit,
  client-supplied list of entities (`wikidata_ids`), scoped via VALUES.

  Each multi-valued field is computed in its own subquery rather than joined
  together in one scope. A flat, single-scope version was tried first and
  measured empirically: for the same 2,000 real entities, the flat form was
  rejected by QLever after 42s ("Sort ... on ?genreLbl"), while this isolated
  form completed in 3.6s. Joining multiple multi-valued OPTIONALs in one scope
  makes SPARQL compute their full cross-product per entity (aliases_fr x
  aliases_en x professions x genres x languages) before GROUP_CONCAT(DISTINCT)
  collapses it back down — for a batch of any real size, that consistently
  costs more than doing five separate, smaller sorts. Isolating avoids it
  entirely, and unlike extract_artists.rq.j2 (which pays a real cost re-deriving
  a broad entity-type+property filter inside each subquery for a huge,
  ID-range-scoped population), doing that here is cheap regardless: every
  subquery just re-states the same small VALUES list.

  cli/extract_from_wikidata.py's hydrate_batch bisects a batch and retries if
  QLever still rejects it (rare in practice, but a single very richly-aliased
  entity can in principle exceed even this pattern's budget on its own) — down
  to a single entity, which is skipped (loudly) rather than blocking the whole
  extraction if it's ever rejected in isolation too.
#}
SELECT
  ?wikidata_id
  ?artist_name_fr
  ?artist_name_en
  ?artist_description
  ?wikipedia_url
  ?img
  ?aliases_fr
  ?aliases_en
  ?professions
  ?genres
  ?languages_spoken
  ?birth_date_val
WHERE {
  VALUES ?wikidata_id { {{ wikidata_ids | join(' ') }} }

  OPTIONAL { ?wikidata_id rdfs:label ?lbl_fr . FILTER(LANG(?lbl_fr) = "fr") }
  OPTIONAL { ?wikidata_id rdfs:label ?lbl_en . FILTER(LANG(?lbl_en) = "en") }
  OPTIONAL { ?wikidata_id rdfs:label ?lbl_mul . FILTER(LANG(?lbl_mul) = "mul") }
  BIND(COALESCE(?lbl_fr, ?lbl_mul, ?lbl_en) AS ?artist_name_fr)
  BIND(?lbl_en AS ?artist_name_en)

  OPTIONAL { ?wikidata_id schema:description ?artist_description . FILTER(LANG(?artist_description) = "fr") }
  OPTIONAL { ?wikidata_id wdt:P18 ?img . }

  OPTIONAL {
    SELECT ?wikidata_id (MIN(?birth_date) AS ?birth_date_val) WHERE {
      VALUES ?wikidata_id { {{ wikidata_ids | join(' ') }} }
      ?wikidata_id wdt:P569 ?birth_date .
    } GROUP BY ?wikidata_id
  }

  OPTIONAL {
    SELECT ?wikidata_id (GROUP_CONCAT(DISTINCT ?alias_fr; separator="|") AS ?aliases_fr) WHERE {
      VALUES ?wikidata_id { {{ wikidata_ids | join(' ') }} }
      ?wikidata_id skos:altLabel ?alias_fr .
      FILTER(LANG(?alias_fr) = "fr")
    } GROUP BY ?wikidata_id
  }

  OPTIONAL {
    SELECT ?wikidata_id (GROUP_CONCAT(DISTINCT ?alias_en; separator="|") AS ?aliases_en) WHERE {
      VALUES ?wikidata_id { {{ wikidata_ids | join(' ') }} }
      ?wikidata_id skos:altLabel ?alias_en .
      FILTER(LANG(?alias_en) = "en")
    } GROUP BY ?wikidata_id
  }

  OPTIONAL {
    SELECT ?wikidata_id (GROUP_CONCAT(DISTINCT ?profLbl; separator="|") AS ?professions) WHERE {
      VALUES ?wikidata_id { {{ wikidata_ids | join(' ') }} }
      ?wikidata_id wdt:P106 ?prof .
      ?prof rdfs:label ?profLbl .
      FILTER(LANG(?profLbl) = "fr")
    } GROUP BY ?wikidata_id
  }

  OPTIONAL {
    SELECT ?wikidata_id (GROUP_CONCAT(DISTINCT ?genreLbl; separator="|") AS ?genres) WHERE {
      VALUES ?wikidata_id { {{ wikidata_ids | join(' ') }} }
      ?wikidata_id wdt:P136 ?genre .
      ?genre rdfs:label ?genreLbl .
      FILTER(LANG(?genreLbl) = "fr")
    } GROUP BY ?wikidata_id
  }

  OPTIONAL {
    SELECT ?wikidata_id (GROUP_CONCAT(DISTINCT ?langLbl; separator="|") AS ?languages_spoken) WHERE {
      VALUES ?wikidata_id { {{ wikidata_ids | join(' ') }} }
      ?wikidata_id wdt:P1412 ?lang .
      ?lang rdfs:label ?langLbl .
      FILTER(LANG(?langLbl) = "fr")
    } GROUP BY ?wikidata_id
  }

  OPTIONAL { ?wikipedia_url_fr schema:about ?wikidata_id ; schema:isPartOf <https://fr.wikipedia.org/> . }
  OPTIONAL { ?wikipedia_url_en schema:about ?wikidata_id ; schema:isPartOf <https://en.wikipedia.org/> . }
  BIND(COALESCE(?wikipedia_url_fr, ?wikipedia_url_en) AS ?wikipedia_url)
}
