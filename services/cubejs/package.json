{
  "name": "cubejs-agent-passculture",
  "version": "0.1.0",
  "description": "Cube.js semantic layer pour pass Culture",
  "private": true,
  "scripts": {
    "lint": "eslint schema/",
    "lint:fix": "eslint schema/ --fix",
    "format": "prettier --write 'schema/**/*.js' '*.js'",
    "format:check": "prettier --check 'schema/**/*.js' '*.js'",
    "check": "npm run format:check && npm run lint",
    "dev": "docker compose up",
    "clean": "rm -rf node_modules .eslintcache"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  }
}
